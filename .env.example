# Copy to .env.local and fill in real values

BACKEND_URL=https://api-bingewise.com
NEXT_PUBLIC_WS_URL=wss://api-bingewise.com/comments/websocket/websocket
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Firebase Cloud Messaging (web)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# GA4 web stream ID (Project Settings → General; used by the GA4/analytics setup)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google AdSense (web)
# Master flag: set to false to disable all ads (dev/staging). Ads also require
# NEXT_PUBLIC_ADSENSE_CLIENT and at least one slot ID.
NEXT_PUBLIC_ADS_ENABLED=true
# Set to true ONLY while your site is pending AdSense approval (loads the tag without
# consent gating so Google's review can see it). Remove after approval.
NEXT_PUBLIC_ADSENSE_VERIFY=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_FEED_SLOT=
NEXT_PUBLIC_ADSENSE_EXPLORE_SLOT=
